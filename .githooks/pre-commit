#!/usr/bin/env bash
# AICAM Pre-commit Hook — v1.4.0
#
# Dispatcher: reads .githooks/config and runs enabled checks.
# Install: git config core.hooksPath .githooks
# Or symlink: ln -sf ../../.githooks/pre-commit .git/hooks/pre-commit

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

FAIL=0
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG="$SCRIPT_DIR/config"

echo -e "${GREEN}── AICAM Pre-commit ──${NC}"

if [ ! -f "$CONFIG" ]; then
  echo -e "${YELLOW}⚠  No config file at $CONFIG — skipping all checks${NC}"
  exit 0
fi

# ── Parse enabled checks from config ──────────────────────────
in_enabled=false
while IFS= read -r line || [ -n "$line" ]; do
  # Detect the "enabled:" section
  if [[ "$line" =~ ^enabled: ]]; then
    in_enabled=true
    continue
  fi

  # Stop when we hit a new top-level key (not indented, has a colon)
  if [[ "$line" =~ ^[a-z] ]] && [[ "$line" == *":"* ]]; then
    in_enabled=false
    continue
  fi

  if $in_enabled; then
    # Skip comments and empty lines
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line// }" ]] && continue

    # Extract check name: remove leading "  - " and strip inline comments
    check=$(echo "$line" | sed 's/^[[:space:]]*-[[:space:]]*//' | sed 's/[[:space:]]*#.*//')
    script="$SCRIPT_DIR/checks/${check}.sh"

    if [ -f "$script" ]; then
      bash "$script" || FAIL=1
    else
      echo -e "  ${YELLOW}⚠  Unknown check: $check ($script not found)${NC}"
    fi
  fi
done < "$CONFIG"

# ── Result ────────────────────────────────────────────────────
echo ""
if [ "$FAIL" -eq 0 ]; then
  echo -e "${GREEN}✅ Pre-commit checks passed${NC}"
  exit 0
else
  echo -e "${RED}❌ Pre-commit checks failed — see details above${NC}"
  echo "  (use git commit --no-verify to bypass, but CI will still run these)"
  exit 1
fi
